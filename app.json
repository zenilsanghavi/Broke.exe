{
  "expo": {
    "name": "Broke.exe",
    "slug": "brokeexe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brokeexe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zennnyyy.brokeexe"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zennnyyy.brokeexe"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#000000",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d9ba942-cd25-4e42-8ed8-e32cb888aa0d"
      }
    },
    "owner": "zennnyyy"
  }
}